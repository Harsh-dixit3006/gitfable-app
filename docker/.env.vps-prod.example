# Backend environment (VPS prod)
ENVIRONMENT=production
PORT=8001

# Database (internal Docker network)
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/gitfable_prod?sslmode=disable
DB_POOL_SIZE=25

# Redis (internal Docker network)
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379

# Auth (GitHub OAuth + JWT)
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_CALLBACK_URL=https://gitfable.app/api/v1/oauth/github/callback
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# CORS
CORS_ORIGINS=https://gitfable.app
FRONTEND_URL=https://gitfable.app

# GitHub
GITHUB_TOKEN=ghp_your_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Rate limiting
RATE_LIMIT_ENABLED=true

# Sync
SYNC_ENABLED=true
SYNC_INTERVAL=6h
STALE_INTERVAL=12h
