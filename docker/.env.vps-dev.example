# Backend environment (VPS dev)
ENVIRONMENT=development
PORT=8001

# Database (internal Docker network)
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/gitfable_dev?sslmode=disable
DB_POOL_SIZE=10

# Redis (internal Docker network)
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379

# Supabase (auth only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS
CORS_ORIGINS=https://dev.gitfable.app
FRONTEND_URL=https://dev.gitfable.app

# GitHub
GITHUB_TOKEN=ghp_your_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Rate limiting
RATE_LIMIT_ENABLED=true

# Sync
SYNC_ENABLED=true
SYNC_INTERVAL=6h
STALE_INTERVAL=12h
