# Test environment for Docker-based workflow tests
# Copy to docker/.env.test or run: make env-test

GITHUB_TOKEN=your_github_token_here
TEST_GITHUB_USERNAME=your_github_username
LIVE_TEST_REPO=your-org/your-demo-repo
LIVE_TEST_ISSUE_NUMBERS=2,3,4,5
LIVE_TEST_PR_NUMBER=7
FULL_WORKFLOW_TEST_REPO=your-org/your-demo-repo
E2E_TEST_REPO=your-org/your-demo-repo
DATABASE_URL=postgresql://gitfable:gitfable@postgres:5432/gitfable_test?sslmode=disable
REDIS_URL=redis://redis:6379
ENVIRONMENT=test
PORT=8001
RATE_LIMIT_ENABLED=false
SYNC_ENABLED=false
